(defconst eink-themes--theme-variants
  '((eink-light . light) (eink-dark . dark))
  "Alist mapping each theme of this package to its variant.")

(defun eink-themes--palette (variant)
  "Return the palette of VARIANT, either `light' or `dark'."
  (pcase variant
    ('light eink-themes-light-palette)
    ('dark eink-themes-dark-palette)
    (_ (error "Unknown variant: %S" variant))))

(defun eink-themes--gray-between (low high red green blue)
  "Return a gray between LOW and HIGH with the brightness of RED GREEN BLUE.
LOW and HIGH are \"#RRGGBB\" gray colors.  RED, GREEN and BLUE are
integers from 0 to 255.  The result is snapped to the nearest of the 16
gray levels."
  (let* ((low (string-to-number (substring low 1 3) 16))
         (high (string-to-number (substring high 1 3) 16))
         (brightness (/ (+ (* 0.299 red) (* 0.587 green) (* 0.114 blue)) 255))
         (level (* 17 (round (+ low (* brightness (- high low))) 17))))
    (format "#%02x%02x%02x" level level level)))

(defun eink-themes--xterm-color-faces (prefix low high)
  "Return face specs for the xterm colors 16 to 255.
Each face name is PREFIX followed by a dash and the color number.  The
colors are mapped to grays between the colors LOW and HIGH."
  (cl-loop
   for index from 16 to 255
   for cube = (- index 16)
   for channels = (if (< index 232)
                      (mapcar (lambda (step) (if (zerop step) 0 (+ 55 (* 40 step))))
                              (list (/ cube 36) (% (/ cube 6) 6) (% cube 6)))
                    (make-list 3 (+ 8 (* 10 (- index 232)))))
   for color = (apply #'eink-themes--gray-between low high channels)
   collect (list (intern (format "%s-%d" prefix index))
                 (list (list t :foreground color :background color)))))

