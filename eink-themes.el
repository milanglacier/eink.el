;;;; Theme definition

(defun eink-themes--current-variant ()
  "Return the variant of the enabled eink theme, or nil if none is enabled."
  (cl-loop for theme in custom-enabled-themes
           thereis (alist-get theme eink-themes--theme-variants)))

(defun eink-themes-theme (theme variant)
  "Set the faces and variables of THEME using the palette of VARIANT.
VARIANT is `light' or `dark'.  This function is meant to be called from
the theme file of THEME."
  (let ((bindings (mapcar (lambda (color) (list (car color) (cdr color)))
                          (eink-themes--palette variant))))
    (apply #'custom-theme-set-faces theme
           (cl-loop for section in eink-themes--faces
                    append (eval `(let ,bindings ,section) t)))
    (apply #'custom-theme-set-variables theme
           (eval `(let ,bindings ,eink-themes--variables) t))))

;;;; Commands

;;;###autoload
(defun eink-themes-toggle ()
  "Switch between `eink-light' and `eink-dark'.
Load `eink-light' if neither theme is enabled."
  (interactive)
  (if-let* ((theme (if (eq (eink-themes--current-variant) 'light)
                       'eink-dark
                     'eink-light))
            (_ (mapc #'disable-theme '(eink-light eink-dark)))
            (_ (custom-theme-p theme)))
      (enable-theme theme)
    (load-theme theme t)))

;;;###autoload
(defun eink-themes-get-color (name &optional variant)
  "Return the palette color NAME as a \"#RRGGBB\" string.
NAME is a symbol such as `fg2'.  VARIANT is `light' or `dark'; it
defaults to the variant of the enabled eink theme."
  (if-let* ((variant (or variant
                         (eink-themes--current-variant)
                         (user-error "No eink theme is enabled")))
            (color (assq name (eink-themes--palette variant))))
      (cdr color)
    (error "Unknown palette color: %S" name)))

(defun eink-themes--run-after-load-theme-hook (theme)
  "Run `eink-themes-after-load-theme-hook' if THEME is an eink theme."
  (when (assq theme eink-themes--theme-variants)
    (run-hooks 'eink-themes-after-load-theme-hook)))

(add-hook 'enable-theme-functions #'eink-themes--run-after-load-theme-hook)

(provide 'eink-themes)

