;;; Commentary:

;; This package provides two themes, `eink-light' and `eink-dark', for
;; real e-ink displays.  Every color is one of the 16 gray levels, so
;; nothing is dithered.  Bold, italic, underline styles and boxes carry
;; the meaning that hue carries in other themes.
;;
;; Load a theme with:
;;
;;     (load-theme 'eink-light t)
;;
;; `eink-themes-toggle' switches between the two themes, and
;; `eink-themes-get-color' returns a palette color for use in your own
;; configuration.

;;; Code:

(require 'cl-lib)

(defgroup eink-themes nil
  "Grayscale themes for e-ink displays."
  :group 'faces
  :prefix "eink-themes-")

(defcustom eink-themes-after-load-theme-hook nil
  "Hook run after `eink-light' or `eink-dark' is enabled."
  :type 'hook
  :group 'eink-themes)

;;;###autoload
(when load-file-name
  (add-to-list 'custom-theme-load-path (file-name-directory load-file-name)))

